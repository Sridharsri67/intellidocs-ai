# ==========================================
# IntelliDocs AI - Root .gitignore
# ==========================================

# ------------------------------------------
# Operating System & IDE files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.pem

# IDEs & Editors
.vscode/
.idea/
*.swp
*.swo
*~

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.*
!.env.example
!.env.local.example

# ------------------------------------------
# Python Dependencies & Virtual Environments
# ------------------------------------------
# Virtual Environments
venv/
venv*/
.venv/
env/
env*/
ENV/
backend/venv/
backend/env/

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Unit tests / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Celery
celerybeat-schedule
celerybeat.pid

# Local document storage & file uploads
backend/storage/documents/*
!backend/storage/documents/.gitkeep
storage/

# ------------------------------------------
# JavaScript / Node.js Dependencies
# ------------------------------------------
node_modules/
frontend/node_modules/
.npm
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ------------------------------------------
# Next.js Build Outputs
# ------------------------------------------
.next/
frontend/.next/
out/
frontend/out/
dist/
frontend/dist/
.vercel

# Testing & Coverage
coverage/
frontend/coverage/
.nyc_output

# Typescript (if any tools generate temp files)
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------
# Local Databases & Volumes
# ------------------------------------------
*.sqlite
*.sqlite3
*.db
pgdata/
redisdata/
